---

<div
  id="konami-overlay"
  class="fixed inset-0 pointer-events-none animate-pulse bg-accent/20 invisible"
>
</div>
<div
  id="konami-message"
  class="fixed inset-0 pointer-events-none z-50 flex items-center justify-center invisible"
>
  <div class="text-6xl font-mono text-accent animate-bounce">
    🎮 30 LIVES! 🎮
  </div>
</div>

<script>
  let konamiActivated = false;
  const konamiCode = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "KeyB",
    "KeyA",
  ];
  let konamiIndex = 0;

  const handleKeyDown = (event: KeyboardEvent) => {
    if (event.code === konamiCode[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === konamiCode.length) {
        konamiActivated = true;
        console.log("🎮 KONAMI CODE ACTIVATED! 30 lives granted!");

        const overlay = document.getElementById("konami-overlay");
        const message = document.getElementById("konami-message");

        if (overlay && message) {
          overlay.classList.remove("invisible");
          message.classList.remove("invisible");

          setTimeout(() => {
            overlay.classList.add("invisible");
            message.classList.add("invisible");
            konamiActivated = false;
          }, 3000);
        }

        konamiIndex = 0;
      }
    } else {
      konamiIndex = 0;
    }
  };

  window.addEventListener("keydown", handleKeyDown);
</script>

